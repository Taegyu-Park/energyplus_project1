! ==========================================================================
! 1F Outer Glass (Gross Area = 11.048 m2, 80% PV cell coverage = 8.838 m2, Module factor = 4.0427)






! ==========================================================================
! SEASONAL DSF DAMPER CONTROL SCHEDULE
! Winter & Transition (Oct-May): 0.0 (Closed - Thermal Buffer Layer)
! Summer (Jun-Sep): 1.0 (Open - Natural Ventilation & Heat Release)
! ==========================================================================
Schedule:Compact,
    DSF_Damper_TopBottom_Schedule,
    Fractional,
    Through: 12/31, For: AllDays, Until: 24:00, 0.0;

Schedule:Compact,
    DSF_Damper_OuterSkin_Schedule,
    Fractional,
    Through: 12/31, For: AllDays, Until: 24:00, 0.0;


