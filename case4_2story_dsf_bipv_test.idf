! ==============================================================================
! KINETIC BIPV SHADING SURFACES & PV GENERATORS (Exact copy from case3_v3_south.idf)
! ==============================================================================

Shading:Zone:Detailed,
    BIPV_Louver_1F,               !- Name
    Cavity_1F_Outer_Wall,         !- Base Surface Name
    TransSched_BIPV_A00,          !- Transmittance Schedule Name
    4,                            !- Number of Vertices
    0.1, -0.8, 3.9,               !- X,Y,Z Vertex 1
    0.1, -0.8, 0.1,               !- X,Y,Z Vertex 2
    3.9, -0.8, 0.1,               !- X,Y,Z Vertex 3
    3.9, -0.8, 3.9;               !- X,Y,Z Vertex 4

Shading:Zone:Detailed,
    BIPV_Louver_2F,               !- Name
    Cavity_2F_Outer_Wall,         !- Base Surface Name
    TransSched_BIPV_A00,          !- Transmittance Schedule Name
    4,                            !- Number of Vertices
    0.1, -0.8, 7.9,               !- X,Y,Z Vertex 1
    0.1, -0.8, 4.1,               !- X,Y,Z Vertex 2
    3.9, -0.8, 4.1,               !- X,Y,Z Vertex 3
    3.9, -0.8, 7.9;               !- X,Y,Z Vertex 4

PhotovoltaicPerformance:EquivalentOne-Diode,
    Shinsung_SolarSkin_390W_Performance,  !- Name
    CrystallineSilicon,           !- Cell type
    66,                           !- Number of Cells in Series
    2.186184,                     !- Active Area {m2}
    0.85,                         !- Transmittance Absorptance Product
    1.12,                         !- Semiconductor Bandgap {eV}
    500.0,                        !- Shunt Resistance {ohms}
    10.42,                        !- Short Circuit Current {A}
    46.64,                        !- Open Circuit Voltage {V}
    25,                           !- Reference Temperature {C}
    1000,                         !- Reference Insolation {W/m2}
    9.99,                         !- Module Current at Maximum Power {A}
    39.11,                        !- Module Voltage at Maximum Power {V}
    0.006252,                     !- Temperature Coefficient of Short Circuit Current {A/K}
    -0.139920,                    !- Temperature Coefficient of Open Circuit Voltage {V/K}
    20,                           !- Nominal Operating Cell Temperature Test Ambient Temperature {C}
    45.0,                         !- Nominal Operating Cell Temperature Test Cell Temperature {C}
    800,                          !- Nominal Operating Cell Temperature Test Insolation {W/m2}
    80.0,                         !- Module Heat Loss Coefficient {W/m2-K}
    50000;

Generator:Photovoltaic,
    PV_Generator_1F,              !- Name
    BIPV_Louver_1F,               !- Surface Name
    PhotovoltaicPerformance:EquivalentOne-Diode, !- Performance Object Type
    Shinsung_SolarSkin_390W_Performance, !- Performance Object Name
    Decoupled,                    !- Heat Transfer Integration Mode
    1.219781,                     !- Parallel Modules (Area scaling factor from case3)
    1.0;                          !- Series Modules

Generator:Photovoltaic,
    PV_Generator_2F,              !- Name
    BIPV_Louver_2F,               !- Surface Name
    PhotovoltaicPerformance:EquivalentOne-Diode, !- Performance Object Type
    Shinsung_SolarSkin_390W_Performance, !- Performance Object Name
    Decoupled,                    !- Heat Transfer Integration Mode
    1.219781,                     !- Parallel Modules (Area scaling factor from case3)
    1.0;                          !- Series Modules

ElectricLoadCenter:Generators,
    BIPV_Generators,              !- Name
    PV_Generator_1F,              !- Generator Name 1
    Generator:Photovoltaic,       !- Generator Object Type 1
    390.0,                        !- Generator Rated Power {W}
    ,                             !- Availability Schedule
    ,                             !- Rated Thermal Power
    PV_Generator_2F,              !- Generator Name 2
    Generator:Photovoltaic,       !- Generator Object Type 2
    390.0,                        !- Generator Rated Power {W}
    ,                             !- Availability Schedule
    ;                             !- Rated Thermal Power

ElectricLoadCenter:Inverter:Simple,
    Main_Inverter,                !- Name
    ,                             !- Availability Schedule Name
    ,                             !- Zone Name
    0.0,                          !- Radiative Fraction
    0.96;                         !- Efficiency

ElectricLoadCenter:Distribution,
    BIPV_Load_Center,             !- Name
    BIPV_Generators,              !- Generator List Name
    Baseload,                     !- Generator Operation Scheme Type
    0.0,                          !- Demand Limit Scheme Purchased Electric Demand Limit {W}
    ,                             !- Track Schedule Name Scheme Name
    ,                             !- Track Meter Scheme Name Meter Name
    DirectCurrentWithInverter,    !- Electrical Buss Type
    Main_Inverter;                !- Inverter Name

! ==============================================================================
! AIRFLOW NETWORK (AFN) & DAMPER OPENINGS
! ==============================================================================

AirflowNetwork:SimulationControl,
    AFN_Control,                  !- Name
    MultizoneWithoutDistribution, !- AirflowNetwork Control
    SurfaceAverageCalculation,    !- Wind Pressure Coefficient Type
    OpeningHeight,                !- Height Selection for Local Wind Pressure Calculation
    LowRise,                      !- Building Type
    500,                          !- Maximum Number of Iterations
    LinearInitializationMethod,   !- Initialization Type
    1.0E-4,                       !- Relative Airflow Convergence Tolerance
    1.0E-6,                       !- Absolute Airflow Convergence Tolerance
    -0.5;                         !- Convergence Acceleration Limit

AirflowNetwork:MultiZone:Zone,
    Cavity_1F_S,                  !- Zone Name
    ;                             !- Ventilation Control Mode (Default)

AirflowNetwork:MultiZone:Zone,
    Cavity_2F_S,                  !- Zone Name
    ;                             !- Ventilation Control Mode (Default)

AirflowNetwork:MultiZone:Component:SimpleOpening,
    AFN_Damper_Component_Bottom,  !- Name
    0.001,                        !- Air Mass Flow Coefficient When Opening is Closed {kg/s-m}
    0.65,                         !- Air Mass Flow Exponent When Opening is Closed
    0.001,                        !- Minimum Opening Factor for Large Opening Ventilation
    0.6;                          !- Discharge Coefficient for Opening

AirflowNetwork:MultiZone:Component:SimpleOpening,
    AFN_Damper_Component_Top,     !- Name
    0.001,                        !- Air Mass Flow Coefficient When Opening is Closed {kg/s-m}
    0.65,                         !- Air Mass Flow Exponent When Opening is Closed
    0.001,                        !- Minimum Opening Factor for Large Opening Ventilation
    0.6;                          !- Discharge Coefficient for Opening

AirflowNetwork:MultiZone:Component:HorizontalOpening,
    AFN_Damper_Component_Horizontal, !- Name
    0.001,                        !- Air Mass Flow Coefficient When Opening is Closed {kg/s-m}
    0.65,                         !- Air Mass Flow Exponent When Opening is Closed
    90,                           !- Sloping Plane Angle {deg}
    0.6;                          !- Discharge Coefficient

AirflowNetwork:MultiZone:Surface,
    Cavity_1F_Outer_Window,       !- Surface Name
    AFN_Damper_Component_Bottom,  !- Leakage Component Name
    ,                             !- External Node Name
    1.0,                          !- Window/Door Opening Factor or Crack Factor
    Constant,                     !- Ventilation Control Mode
    ,                             !- Temperature Setpoint Schedule Name
    0.0,                          !- Minimum Venting Open Factor
    0.0,                          !- Temp Diff Lower Limit
    100.0,                        !- Temp Diff Upper Limit
    0.0,                          !- Enthalpy Diff Lower Limit
    300000.0,                     !- Enthalpy Diff Upper Limit
    DSF_Damper_Bottom_Sched;      !- Venting Availability Schedule Name

AirflowNetwork:MultiZone:Surface,
    Cavity_2F_Outer_Window,       !- Surface Name
    AFN_Damper_Component_Top,     !- Leakage Component Name
    ,                             !- External Node Name
    1.0,                          !- Window/Door Opening Factor or Crack Factor
    Constant,                     !- Ventilation Control Mode
    ,                             !- Temperature Setpoint Schedule Name
    0.0,                          !- Minimum Venting Open Factor
    0.0,                          !- Temp Diff Lower Limit
    100.0,                        !- Temp Diff Upper Limit
    0.0,                          !- Enthalpy Diff Lower Limit
    300000.0,                     !- Enthalpy Diff Upper Limit
    DSF_Damper_Top_Sched;         !- Venting Availability Schedule Name

AirflowNetwork:MultiZone:Surface,
    Cavity_1F_2F_Boundary_Bottom, !- Surface Name
    AFN_Damper_Component_Horizontal, !- Leakage Component Name
    ,                             !- External Node Name
    1.0;                          !- Window/Door Opening Factor or Crack Factor

! ==============================================================================
! PYTHON PLUGIN BINDINGS
! ==============================================================================

PythonPlugin:Instance,
    DSF_BIPV_Control_Instance,    !- Name
    Yes,                          !- Run During Warmup Days
    dsf_bipv_integrated_control,  !- Python Module Name
    IntegratedDSFAndBIPVControlPlugin; !- Plugin Class Name

EnergyManagementSystem:GlobalVariable,
    BIPV_Tilt_Angle,
    DSF_Bottom_Damper,
    DSF_Top_Damper,
    DSF_Operating_Mode;

! ==============================================================================
! OUTPUT REPORTING
! ==============================================================================

Output:Variable, Core_1F, Zone Mean Air Temperature, Hourly;
Output:Variable, Core_2F, Zone Mean Air Temperature, Hourly;
Output:Variable, Cavity_1F_S, Zone Mean Air Temperature, Hourly;
Output:Variable, Cavity_2F_S, Zone Mean Air Temperature, Hourly;
Output:Variable, *, Site Outdoor Air Drybulb Temperature, Hourly;
Output:Variable, *, Generator Produced DC Electricity Rate, Hourly;
Output:Variable, *, AFN Node Temperature, Hourly;

Output:Table:SummaryReports,
    AllSummary;

OutputControl:Table:Style,
    HTML;
