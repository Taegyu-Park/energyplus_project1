! ==============================================================================
! EnergyPlus v25.2 Input Data File (IDF)
! Project: Gwangju 2-Story Kinetic BIPV + Double-Skin Facade (DSF) Benchmark
! Location: Gwangju, South Korea
! Control: dsf_bipv_integrated_control.py (Python Plugin)
! Synchronized with: case3_v3_south.idf
! ==============================================================================

Version,
    25.2;

Building,
    Gwangju_2Story_DSF_KineticBIPV, !- Name
    0,                            !- North Axis {deg}
    City,                         !- Terrain
    0.04,                         !- Loads Convergence Tolerance Value {W}
    0.4,                          !- Temperature Convergence Tolerance Value {deltaC}
    FullExterior,                 !- Solar Distribution
    25;                           !- Maximum Number of Warmup Days

Timestep,
    6;

SurfaceConvectionAlgorithm:Inside,
    AdaptiveConvectionAlgorithm;

SurfaceConvectionAlgorithm:Outside,
    AdaptiveConvectionAlgorithm;

HeatBalanceAlgorithm,
    ConductionTransferFunction;

ShadowCalculation,
    PolygonClipping,              !- Shading Calculation Method
    Periodic,                     !- Shading Calculation Update Frequency Method
    20;                           !- Shading Calculation Update Frequency

GlobalGeometryRules,
    UpperLeftCorner,              !- Starting Vertex Position
    CounterClockWise,             !- Vertex Entry Direction
    World;                        !- Coordinate System

SimulationControl,
    No,                           !- Do Zone Sizing Calculation
    No,                           !- Do System Sizing Calculation
    No,                           !- Do Plant Sizing Calculation
    No,                           !- Run Simulation for Sizing Periods
    Yes,                          !- Run Simulation for Weather File Hours
    No,                           !- Do HVAC Sizing Simulation for Sizing Periods
    1;                            !- Maximum Number of HVAC Sizing Simulation Passes

RunPeriod,
    ANNUAL_RUN,                   !- Name
    1,                            !- Begin Month
    1,                            !- Begin Day of Month
    2026,                         !- Begin Year
    12,                           !- End Month
    31,                           !- End Day of Month
    2026,                         !- End Year
    Thursday,                     !- Day of Week for Start Day
    Yes,                          !- Use Weather File Holidays and Special Days
    Yes,                          !- Use Weather File Daylight Saving Period
    No,                           !- Apply Weekend Holiday Rule
    Yes,                          !- Use Weather File Rain Indicators
    Yes;                          !- Use Weather File Snow Indicators

! ==============================================================================
! SCHEDULE TYPETYPES & COMPACT SCHEDULES
! ==============================================================================

ScheduleTypeLimits,
    Fraction,                     !- Name
    0.0,                          !- Lower Limit Value
    1.0,                          !- Upper Limit Value
    Continuous;                   !- Numeric Type

ScheduleTypeLimits,
    Any Number;                   !- Name

Schedule:Compact,
    DSF_Damper_Bottom_Sched,      !- Name
    Fraction,                     !- Schedule Type Limits Name
    Through: 12/31,               !- Field 1
    For: AllDays,                 !- Field 2
    Until: 24:00, 0.0;            !- Field 3 (Overridden by Python Plugin)

Schedule:Compact,
    DSF_Damper_Top_Sched,         !- Name
    Fraction,                     !- Schedule Type Limits Name
    Through: 12/31,               !- Field 1
    For: AllDays,                 !- Field 2
    Until: 24:00, 0.0;            !- Field 3 (Overridden by Python Plugin)

Schedule:Compact,
    TransSched_BIPV_A00, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A10, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A20, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A30, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A40, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A50, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A60, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A70, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A80, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;
Schedule:Compact,
    TransSched_BIPV_A90, Fraction, Through: 12/31, For: AllDays, Until: 24:00, 1.0;

! ==============================================================================
! MATERIALS & CONSTRUCTIONS (Exact copy from case3_v3_south.idf)
! ==============================================================================

Material,
    Generic Brick,                !- Name
    MediumRough,                  !- Roughness
    0.1,                          !- Thickness {m}
    0.9,                          !- Conductivity {W/m-K}
    1920,                         !- Density {kg/m3}
    790,                          !- Specific Heat {J/kg-K}
    0.9,                          !- Thermal Absorptance
    0.65,                         !- Solar Absorptance
    0.65;                         !- Visible Absorptance

